parameters:
    level: 6
    phpVersion: 80200

    # Dein Modulverzeichnis analysieren
    paths:
        - ./

    # Stubs mit IPS-Funktionen
    scanDirectories:
        - %env.IPS_STUBS_PATH%

    excludePaths:
        analyse:
            - %env.IPS_STUBS_PATH%/*

    ignoreErrors:
        - message: '#Function AC_AddLoggedValues not found#'
        - message: '#Function AC_ReAggregateVariable not found#'
        - message: '#Function AC_SetLoggingStatus not found#'
        - message: '#Function AC_SetAggregationType not found#'
        - message: '#Function AC_SetCounterIgnoreZeros not found#'
        - message: '#Function AC_GetLoggingStatus not found#'
        - message: '#Function AC_GetLoggedValues not found#'
        - message: '#Function AC_DeleteVariableData not found#'

    # Supress ignore Errors
    reportUnmatchedIgnoredErrors: false